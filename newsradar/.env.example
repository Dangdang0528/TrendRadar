# NewsRadar 环境变量示例(复制为 .env 后填值)

# === 应用 ===
APP_NAME=NewsRadar
APP_ENV=dev
DEBUG=true
SECRET_KEY=dev-only-change-me-in-production-please-32bytes-plus
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 数据库 ===
DATABASE_URL=postgresql+psycopg://newsradar:newsradar@db:5432/newsradar
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# === Redis / 队列 ===
REDIS_URL=redis://redis:6379/0
ARQ_MAX_TRIES=3
ARQ_TIMEOUT_SECONDS=600
WORKER_CONCURRENCY=4

# === 邮件(注册激活;不填则跳过验证邮件)===
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your@qq.com
# SMTP_PASSWORD=your-auth-code
# SMTP_FROM=your@qq.com
APP_BASE_URL=http://localhost:8000

# === 凭证加密(生成 32 字节 base64 key:fernet generate-key)===
CREDENTIAL_ENCRYPTION_KEY=dev-only-change-me-32-bytes-base64-or-hex!!

# === AI 全局 key(方案 B:per-user 开关,全局一个 key)===
# AI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o-mini
# AI_API_BASE=
AI_TIMEOUT=120
AI_MAX_TOKENS=5000

# === TrendRadar 核心 ===
TRENDRADAR_WORK_DIR=/app/vendor
# PLATFORMS_API_URL=https://api.example.com

# === 速率限制 ===
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=30
AI_PER_USER_RATE_LIMIT_PER_HOUR=2
